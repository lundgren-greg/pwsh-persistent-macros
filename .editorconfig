root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,json,yml,yaml,js,cjs,mjs,ts,tsx,jsx}]
indent_size = 2

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.xaml]
indent_size = 2
